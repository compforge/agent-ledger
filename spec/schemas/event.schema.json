{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/compforge/agent-ledger/main/spec/schemas/event.schema.json",
  "title": "Agent Ledger Event",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "lane_id",
    "subject_id",
    "event_type",
    "actor_id",
    "occurred_at",
    "payload",
    "extensions"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "$ref": "#/$defs/uuidV7" },
    "lane_id": { "$ref": "#/$defs/uuidV7" },
    "subject_id": { "type": "string", "minLength": 1 },
    "event_type": {
      "type": "string",
      "pattern": "^(session|run|lane|turn|action|attempt)\\..+$"
    },
    "actor_id": { "$ref": "#/$defs/uuidV7" },
    "causation_id": { "$ref": "#/$defs/uuidV7" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "extensions": { "type": "object" },
    "seq": { "type": "integer", "minimum": 1 },
    "committed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artifact_ref": {
      "type": "object",
      "required": ["uri", "sha256", "size", "content_type"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "content_type": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
